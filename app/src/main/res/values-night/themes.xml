<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.DogsLovers" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- Cor principal -->
        <item name="colorPrimary">@color/primary</item>

        <!-- Texto/ícones sobre a cor primária -->
        <item name="colorOnPrimary">@color/black</item>

        <!-- Cor secundária -->
        <item name="colorSecondary">@color/secondary_light</item>

        <!-- Texto/ícones sobre a cor secundária -->
        <item name="colorOnSecondary">@color/black</item>

        <!-- Fundo principal -->
        <item name="android:colorBackground">@color/black</item>

        <!-- Texto padrão -->
        <item name="android:textColorPrimary">@color/white</item>

        <!-- Cards, Dialogs, BottomSheet -->
        <item name="colorSurface">@color/surface_dark</item>

        <!-- Texto sobre superfícies -->
        <item name="colorOnSurface">@color/white</item>

        <!-- Cor de erro -->
        <item name="colorError">@color/error_dark</item>

        <!-- Texto sobre erro -->
        <item name="colorOnError">@color/black</item>

        <!-- Barra de navegação -->
        <item name="android:navigationBarColor">@color/black</item>

        <!-- Tipografia -->
        <item name="textAppearanceHeadline1">
            @style/TextAppearance.DogsLovers.Dark.Headline1
        </item>

        <item name="textAppearanceHeadline2">
            @style/TextAppearance.DogsLovers.Dark.Headline2
        </item>

        <item name="textAppearanceBody1">
            @style/TextAppearance.DogsLovers.Dark.Body1
        </item>

        <item name="textAppearanceBody2">
            @style/TextAppearance.DogsLovers.Dark.Body2
        </item>

        <item name="textAppearanceCaption">
            @style/TextAppearance.DogsLovers.Dark.Caption
        </item>

        <item name="textAppearanceButton">
            @style/TextAppearance.DogsLovers.Dark.Button
        </item>

    </style>


    <style name="TextAppearance.DogsLovers.Dark.Headline1"
        parent="@style/TextAppearance.MaterialComponents.Headline1">

        <item name="fontFamily">@font/agbalumo</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/white</item>

    </style>

    <style name="TextAppearance.DogsLovers.Dark.Headline2"
        parent="@style/TextAppearance.MaterialComponents.Headline2">

        <item name="fontFamily">@font/agbalumo</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/white</item>

    </style>

    <style name="TextAppearance.DogsLovers.Dark.Body1"
        parent="@style/TextAppearance.MaterialComponents.Body1">

        <item name="fontFamily">@font/agbalumo</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_dark_primary</item>

    </style>

    <style name="TextAppearance.DogsLovers.Dark.Body2"
        parent="@style/TextAppearance.MaterialComponents.Body2">

        <item name="fontFamily">@font/agbalumo</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_dark_secondary</item>

    </style>

    <style name="TextAppearance.DogsLovers.Dark.Caption"
        parent="@style/TextAppearance.MaterialComponents.Caption">

        <item name="fontFamily">@font/agbalumo</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_dark_secondary</item>

    </style>

    <style name="TextAppearance.DogsLovers.Dark.Button"
        parent="@style/TextAppearance.MaterialComponents.Button">

        <item name="fontFamily">@font/agbalumo</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>

    </style>

    <style name="Theme.DogsLovers"
        parent="Base.Theme.DogsLovers" />
</resources>